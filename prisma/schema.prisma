generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  FILE
  URL
  TEXT
}

enum ActionType {
  FOLLOW
  SUBSCRIBE
  JOIN
  EMAIL
  VISIT
}

enum VerificationMode {
  AUTO
  MANUAL
  OAUTH
}

enum UnlockSessionStatus {
  STARTED
  IN_PROGRESS
  COMPLETED
  UNLOCKED
}

enum AnalyticsEventType {
  VIEW
  START
  ACTION_COMPLETE
  UNLOCK
}

enum AudienceStatus {
  VERIFIED
  ACTIVE
  UNKNOWN
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum PaymentType {
  SUBSCRIPTION
  ONE_TIME
  PAYOUT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  CAMPAIGN
}

model User {
  id               String   @id @default(cuid())
  clerkId          String   @unique
  username         String   @unique
  displayName      String?
  bio              String?
  avatarUrl        String?
  email            String?
  role             UserRole @default(USER)
  stripeCustomerId String?
  stripeConnectId  String?
  banned           Boolean  @default(false)
  notifyUnlockEmail    Boolean @default(true)
  notifyWeeklyEmail    Boolean @default(false)
  notifySecurityEmail  Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaigns        Campaign[]
  subscriptions    Subscription[]
  payments         Payment[]
  payouts          Payout[]
  audienceMembers  AudienceMember[]
  reports          Report[]         @relation("Reporter")
  notifications    Notification[]

  @@index([username])
  @@index([clerkId])
}

model Campaign {
  id          String         @id @default(cuid())
  userId      String
  slug        String
  title       String
  description String?
  buttonText  String         @default("UNLOCK")
  logoUrl              String?
  theme                String         @default("default")
  backgroundMusicUrl   String?
  backgroundVideoUrl   String?
  status      CampaignStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  content         Content?
  actions         Action[]
  unlockSessions  UnlockSession[]
  analyticsEvents AnalyticsEvent[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([status])
}

model Content {
  id          String      @id @default(cuid())
  campaignId  String      @unique
  type        ContentType
  fileUrl     String?
  fileName    String?
  externalUrl String?
  textBody    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Action {
  id               String           @id @default(cuid())
  campaignId       String
  type             ActionType
  label            String
  config           Json             @default("{}")
  sortOrder        Int              @default(0)
  verificationMode VerificationMode @default(MANUAL)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model UnlockSession {
  id               String              @id @default(cuid())
  campaignId       String
  visitorId        String
  status           UnlockSessionStatus @default(STARTED)
  completedActions Json                @default("[]")
  unlockedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([visitorId])
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  campaignId String
  type       AnalyticsEventType
  source     String?
  country    String?
  device     String?
  browser    String?
  metadata   Json               @default("{}")
  createdAt  DateTime           @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([type])
}

model AudienceMember {
  id        String         @id @default(cuid())
  userId    String
  email     String?
  name      String?
  source    String?
  status    AudienceStatus @default(UNKNOWN)
  joinedAt  DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  plan                 SubscriptionPlan   @default(FREE)
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(ACTIVE)
  period               String             @default("monthly")
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  amount          Int
  currency        String        @default("usd")
  stripePaymentId String?       @unique
  type            PaymentType
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payout {
  id               String       @id @default(cuid())
  userId           String
  amount           Int
  currency         String       @default("usd")
  stripeTransferId String?      @unique
  status           PayoutStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String?
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  reporter User? @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
