# Copy to `.env.local` and fill in your values.
# `.env.local` is gitignored — your secrets stay on your machine only.

# --- Required for auth + dashboard ---

# Clerk - https://dashboard.clerk.com
#
# LOCAL DEV (`npm run dev`):
#   Use Development instance keys in `.env.development.local` (pk_test_ / sk_test_).
#   Copy from `.env.development.local.example` — live keys do NOT work on localhost.
#
# PRODUCTION (Vercel / linklock.org):
#   Use Production instance keys below (pk_live_ / sk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Production domain only — used on Vercel builds, ignored during local `npm run dev`
NEXT_PUBLIC_CLERK_DOMAIN=linklock.org

# Clerk routes (relative paths work on your custom domain)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Clerk webhook endpoint (Production instance):
#   https://linklock.org/api/webhooks/clerk
# Events: user.created, user.updated, user.deleted

# Supabase database (TWO lines — both required)
DATABASE_URL=
DIRECT_URL=

# Site URLs
SITE_URL=https://linklock.org
NEXT_PUBLIC_SITE_URL=https://linklock.org
NEXT_PUBLIC_APP_URL=https://linklock.org

# Admin
ADMIN_EMAIL=

# --- AdSense (server-only; not exposed to the browser bundle) ---
ADSENSE_CLIENT=
ADSENSE_UNLOCK_SLOT=
ADSENSE_UNLOCK_SLOT_LEFT=
ADSENSE_UNLOCK_SLOT_RIGHT=

# --- Stripe (Pro billing) — run: npm run stripe:setup ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID_USD=
STRIPE_PRO_YEARLY_PRICE_ID_USD=
STRIPE_PRO_MONTHLY_PRICE_ID_GBP=
STRIPE_PRO_YEARLY_PRICE_ID_GBP=
STRIPE_PRO_MONTHLY_PRICE_ID_PLN=
STRIPE_PRO_YEARLY_PRICE_ID_PLN=

# When live: full retro marketing site (Features, Pricing, etc.).
# Set LINKLOCK_SIMPLE_PUBLIC=true to redirect extra pages to home only.
LINKLOCK_SIMPLE_PUBLIC=
