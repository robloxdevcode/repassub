# Copy to `.env.local` and fill in your values.
# `.env.local` is gitignored — your secrets stay on your machine only.

# --- Required for auth + dashboard ---

# Clerk - https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase database (TWO lines — both required)
DATABASE_URL=
DIRECT_URL=

# Site URLs
SITE_URL=https://linklock.org
NEXT_PUBLIC_SITE_URL=https://linklock.org
NEXT_PUBLIC_APP_URL=https://linklock.org

# Admin
ADMIN_EMAIL=

# --- AdSense (unlock page ads) ---
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_UNLOCK_SLOT_LEFT=
NEXT_PUBLIC_ADSENSE_UNLOCK_SLOT_RIGHT=

# --- Stripe (Pro billing) — run: npm run stripe:setup ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID_USD=
STRIPE_PRO_YEARLY_PRICE_ID_USD=
STRIPE_PRO_MONTHLY_PRICE_ID_GBP=
STRIPE_PRO_YEARLY_PRICE_ID_GBP=
STRIPE_PRO_MONTHLY_PRICE_ID_PLN=
STRIPE_PRO_YEARLY_PRICE_ID_PLN=
