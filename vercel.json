{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Ads.txt",
      "destination": "/ads.txt",
      "permanent": true
    },
    {
      "source": "/ADS.TXT",
      "destination": "/ads.txt",
      "permanent": true
    }
  ]
}
